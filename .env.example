# Public base URL of the application, used to generate image URLs and email links.
# Set this in production: when unset, upload URLs fall back to http://<SERVER_HOST>:<SERVER_PORT>
# and email links to https://<SERVER_HOST>, neither of which is usually reachable.
BASE_URL=http://localhost:3000

# Secret key used to sign JWT tokens. Generate with: openssl rand -base64 32
JWT_SECRET_KEY=
# Lifetime of access tokens in minutes
#JWT_SECRET_EXPIRE_MINUTES=60
# Lifetime of refresh tokens in minutes
#JWT_REFRESH_EXPIRE_MINUTES=10080

# Log level: trace, debug, info, warn, error (unknown values fall back to info)
#LOG_LEVEL=info
# Log output target: console, file, or both
#LOG_TARGET=console
# File path when LOG_TARGET includes file
#LOG_FILE_PATH=./data/smetana.log
# Enable HTTP request logging
#LOG_REQUESTS=false
# Enable GORM SQL query logging
#LOG_DB_QUERIES=false

# Supported database types: sqlite, mysql, postgres
#DB_TYPE=sqlite
# SQLite: path to the database file. MySQL / PostgreSQL: database name (e.g. smetana)
#DB_NAME=./data/borscht.db
# MySQL / PostgreSQL connection settings (used when DB_TYPE=mysql or DB_TYPE=postgres).
#DB_HOST=localhost
# Defaults to 3306 (MySQL) or 5432 (PostgreSQL)
#DB_PORT=
#DB_USER=smetana
#DB_PASSWORD=secret
# PostgreSQL SSL mode: disable, require, verify-ca, verify-full
#DB_SSLMODE=disable

# By default, files are stored locally in STORAGE_ROOT and served at /uploads.
#STORAGE_ROOT=./data/uploads

# To use S3-compatible remote storage (AWS S3, Cloudflare R2, MinIO, Backblaze B2),
# set S3_BUCKET and the corresponding credentials below:
#S3_BUCKET=
# S3 endpoint URL (e.g., https://s3.amazonaws.com or https://<account_id>.r2.cloudflarestorage.com)
#S3_ENDPOINT=
#S3_REGION=us-east-1
#S3_ACCESS_KEY=
#S3_SECRET_KEY=
# S3 HTTP timeout in seconds
#S3_TIMEOUT=10

# Interval between automated RSS/Atom feed syncs (Go duration string: e.g., 24h, 12h, 1h)
#FETCH_INTERVAL=24h
# Max parallel fetches within a single feed sync run or recipe import
#FETCH_CONCURRENCY=5
# Concurrency limit for feed subscription synchronization
#FEED_SYNC_CONCURRENCY=2

# Timeout for downloading recipe images
#DOWNLOAD_TIMEOUT=30s
# Timeout for scraping a recipe page (returns 504 when exceeded)
#SCRAPE_TIMEOUT=30s
# Custom User-Agent string for image downloads
#USER_AGENT=Mozilla/5.0 (Windows NT 10.0; rv:80.0) Gecko/20100101 Firefox/80.0

# Required for password reset and household invitation emails.
# Disabled if SMTP_HOST is not set.
#SMTP_HOST=
#SMTP_PORT=587
#SMTP_USER=
#SMTP_PASSWORD=
#SMTP_FROM=noreply@example.com

# Required for OIDC SSO authentication. Disabled if provider, client ID or secret is missing.
# OIDC_REDIRECT_URL defaults to <BASE_URL>/api/v1/auth/oidc/callback
#OIDC_PROVIDER=https://accounts.google.com
#OIDC_CLIENT_ID=
#OIDC_CLIENT_SECRET=
#OIDC_REDIRECT_URL=http://localhost:3000/api/v1/auth/oidc/callback

# Enable rate limiting across all endpoints (auth routes are always rate-limited)
#ENABLE_LIMITER=false
# Enable gzip/brotli response compression
#ENABLE_COMPRESS=false

# Bind host (leave empty to bind all interfaces)
#SERVER_HOST=
# Port on which the HTTP server will listen
#SERVER_PORT=3000

# HTTP server timeouts in seconds
#SERVER_READ_TIMEOUT=15
#SERVER_WRITE_TIMEOUT=30
#SERVER_IDLE_TIMEOUT=120
